# Example .env file for Unified-NSE-Analysis
# Copy to `.env` and fill real values. DO NOT commit `.env` (it's ignored).
#
# Replace placeholders with real values required by your environment.

# API keys
API_KEY=your_api_key_here
ALTERNATE_API_KEY=your_alternate_api_key_here

# Web search (working-sector): SerpAPI for Yahoo search
SERPAPI_API_KEY=your_serpapi_key_here

# Database / storage
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unified_nse
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Email / notifications
# Default report mailer is Outlook draft/send. Use applemail for locally configured Apple Mail,
# or gmail/icloud/smtp to send directly via SMTP.
AGENT_ADDA_EMAIL_PROVIDER=outlook
# Gmail sender setup:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create a Google App Password.
#   3. Put that app password in SMTP_PASSWORD. Do not use the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=agentadda.in@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM=agentadda.in@gmail.com
EMAIL_FROM_NAME=Agent Adda
SMTP_USE_TLS=1

# WhatsApp Business Cloud API notifications
# Official Cloud API supports direct WhatsApp Business messaging. Community/channel
# posting still requires manual posting or a separately approved/supported Meta path.
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENTS=
WHATSAPP_USE_TEMPLATE=false
WHATSAPP_TEMPLATE_NAME=agent_adda_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TIMEOUT_SECONDS=15

# iCloud sender setup:
#   1. Create an Apple app-specific password.
#   2. Set AGENT_ADDA_EMAIL_PROVIDER=icloud.
#   3. Put the app-specific password in SMTP_PASSWORD.
# SMTP_HOST=smtp.mail.me.com
# SMTP_PORT=587
# SMTP_USER=pgorai@icloud.com
# SMTP_PASSWORD=your_icloud_app_specific_password
# SMTP_FROM=pgorai@icloud.com
# IMAP_HOST=imap.mail.me.com
# IMAP_PORT=993

# Apple Mail sender setup:
#   Uses the account already configured in macOS Mail. No SMTP password needed.
# AGENT_ADDA_EMAIL_PROVIDER=applemail
# APPLEMAIL_ACCOUNT=pgorai@icloud.com
# SMTP_FROM=pgorai@icloud.com

# Other settings
LOG_LEVEL=INFO
DATA_DIR=data

# Ollama (local LLM) for dashboard market narrative
# Set OLLAMA_NARRATIVE_ENABLED=1 to use local Ollama to generate the narrative; otherwise rule-based narrative is used.
OLLAMA_NARRATIVE_ENABLED=0
OLLAMA_MODEL=granite4
OLLAMA_BASE_URL=http://localhost:11434

# Stock Email Agent (stock_email_agent/)
# Gmail IMAP — use an App Password, NOT your real password
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_MAILBOX=INBOX
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
# Optional comma-separated lists
STOCK_EMAIL_SENDERS=
STOCK_EMAIL_KEYWORDS=results,dividend,split,bonus,buyback,rights,agm,egm,board meeting,earnings,quarterly,annual report,corporate action

# LLM provider switch for the stock email agent
STOCK_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_API_KEY already typically set; model override below
OPENAI_MODEL=gpt-4o-mini
STOCK_LLM_MAX_TOKENS=1200
STOCK_LLM_TEMPERATURE=0.3

# End of file
